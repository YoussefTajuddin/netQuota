# pacman .install hooks. Reference this from PKGBUILD as
# install=netquota.install once this is a real package build (kept
# separate here since it isn't wired into the skeleton PKGBUILD by default).

post_install() {
    getent passwd netquota >/dev/null || \
        useradd --system --no-create-home --shell /usr/bin/nologin netquota
    install -d -o netquota -g netquota -m 0750 /var/lib/netquota
    [ -f /etc/netquota.conf ] || cp /etc/netquota.conf.example /etc/netquota.conf
    echo "Next: sudo netquota setup   (then: sudo systemctl enable --now netquota.service)"
}

post_upgrade() {
    post_install
}

pre_remove() {
    systemctl disable --now netquota.service 2>/dev/null || true
    nft delete table inet netquota 2>/dev/null || true
}

post_remove() {
    getent passwd netquota >/dev/null && userdel netquota 2>/dev/null || true
}
